{
  "lastChangelogVersion": "0.87.0",
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-6-sol",
  "hideThinkingBlock": true,
  "defaultThinkingLevel": "high",
  "packages": [
    "npm:pi-schedule-prompt",
    "git:github.com/chrismdp/pi-tool-display@f1c95b41d80d440cca8b36a1ebeba342f2074e14"
  ],
  "theme": "gruvbox",
  "quietStartup": true,
  "tuiMode": "regular",
  "steeringMode": "all",
  "compaction": {
    "enabled": true
  },
  "editorPaddingX": 1,
  "outputPad": 1,
  "autocompleteMaxVisible": 7,
  "terminal": {
    "showTerminalProgress": true
